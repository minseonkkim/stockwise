# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trade
DB_USER=trade
DB_PASSWORD=trade_secret

# Redis
REDIS_URL=redis://localhost:6379/0

# Data Collection
START_DATE=2010-01-01
YFINANCE_DELAY=0.3
BATCH_SIZE=50

# Notifications (optional)
SLACK_WEBHOOK_URL=

# Alpha Vantage (optional, for fundamental data later)
ALPHA_VANTAGE_API_KEY=

# FRED (optional, for macro features later)
FRED_API_KEY=

# Airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://trade:trade_secret@localhost:5432/airflow
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__CORE__LOAD_EXAMPLES=False
